---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.tech-stack-section {
				margin: 0;
				padding: 0;
			}
			.about-content {
				line-height: 1.6;
				margin-bottom: 2em;
			}
			.about-content p {
				margin: 0.5em 0;
			}
			.links-section {
				margin: 2em 0;
			}
			.about-me-section {
				margin: 2em 0;
			}
			.about-me-section h3 {
				margin-bottom: 1em;
			}
			.about-me-section p {
				line-height: 1.6;
				margin: 0.75em 0;
			}
			.read-links-section {
				margin: 2em 0;
			}
			hr {
				margin: 2em auto;
				border: none;
				border-top: 1px solid var(--primary);
				width: 20%;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="tech-stack-section">
				<h3>Developer Portfolio</h3>

				<div class="links-section">
					<p>
						<a href="https://www.linkedin.com/in/opoupier/" target="_blank" rel="noopener noreferrer">LinkedIn</a> •
						<a href="https://github.com/olivierpoupier" target="_blank" rel="noopener noreferrer">GitHub</a> •
						<a href="mailto:olivier@poupier.net">Email</a> •
						<a href="/resume.pdf" download>Resume</a>
					</p>
				</div>

				<div class="about-me-section">
					<h4>About Me</h4>
					<p>
						I'm a developer focused on building thoughtful, user-centeric applications. My work mostly consists of finding creative and efficient solutions tailored to specific client needs.
					</p>
					<p>
						I'm passionate about continuous learning and pushing the boundaries of my skills.
						I have always been passionate about finding elegant solutions to solve challenges, cybersecurity, electronics and robotics.
					</p>
					<p>
						In the past years I have had the chance to build a lot of webapps and touch the cybersecurity field.
						Looking ahead, I aim to work on projects that will keep challenging me and allowing me to touch more of the subjects I'm passionate about.
					</p>
				</div>

				<hr />

				<div class="read-links-section">
					<p>
						Read about past projects <a href="/case-studies">here</a>
					</p>
					<p>
						Read about what's racking my brain <a href="/blog">here</a>
					</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
