---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Get in touch with me" />
		<style>
			.contact-lists {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
				margin: 2rem 0;
			}

			.contact-list {
				background: var(--color-bg-secondary, #f5f5f5);
				padding: 1.5rem;
				border-radius: 8px;
			}

			.contact-list h4 {
				margin-top: 0;
				margin-bottom: 1rem;
			}

			.contact-list ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.contact-list li {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				margin-bottom: 1rem;
				line-height: 1.4;
			}

			.contact-list li:last-child {
				margin-bottom: 0;
			}

			.icon {
				flex-shrink: 0;
				width: 20px;
				height: 20px;
				margin-top: 0.1rem;
			}

			.icon.check {
				filter: invert(48%) sepia(79%) saturate(500%) hue-rotate(86deg) brightness(95%) contrast(90%);
			}

			.icon.cancel {
				filter: invert(33%) sepia(93%) saturate(1800%) hue-rotate(340deg) brightness(90%) contrast(95%);
			}

			@media (max-width: 768px) {
				.contact-lists {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h2>Contact</h2>

			<div class="contact-lists">
				<div class="contact-list">
					<h4>Good reasons to reach out</h4>
					<ul>
						<li>
							<img src="/check.svg" alt="Check" class="icon check" />
							<span>Consulting or freelance opportunities</span>
						</li>
						<li>
							<img src="/check.svg" alt="Check" class="icon check" />
							<span>Collaboration on interesting projects</span>
						</li>
						<li>
							<img src="/check.svg" alt="Check" class="icon check" />
							<span>Speaking engagements or podcasts</span>
						</li>
						<li>
							<img src="/check.svg" alt="Check" class="icon check" />
							<span>Technical discussions and feedback</span>
						</li>
					</ul>
				</div>

				<div class="contact-list">
					<h4>Bad reasons to reach out</h4>
					<ul>
						<li>
							<img src="/cancel.svg" alt="Cancel" class="icon cancel" />
							<span>Unsolicited sales pitches</span>
						</li>
						<li>
							<img src="/cancel.svg" alt="Cancel" class="icon cancel" />
							<span>SEO or marketing services</span>
						</li>
						<li>
							<img src="/cancel.svg" alt="Cancel" class="icon cancel" />
							<span>Cryptocurrency or get-rich-quick schemes</span>
						</li>
						<li>
							<img src="/cancel.svg" alt="Cancel" class="icon cancel" />
							<span>Requests to do free work or spec work</span>
						</li>
					</ul>
				</div>
			</div>

			<p>For consulting or freelance work inquiries, feel free to email me at: <a href="mailto:olivier@poupier.net">olivier@poupier.net</a></p>
		</main>
		<Footer />
	</body>
</html>