---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/now">Now</HeaderLink>
			<HeaderLink href="/case-studies">Works</HeaderLink>
			<HeaderLink href="/blog">Side tracks</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
			padding: 0 1em;
			background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.5em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		transition: font-style 0.2s ease;
		font-style: normal;
	}

	h2 a:hover {
		font-style: italic;
		border-bottom: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--primary);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		background-color: transparent;
	}
	nav a:hover {
		background-color: transparent;
		border-bottom-color: var(--primary-tint);
	}
	nav a.active {
		color: var(--primary);
		text-decoration: none;
		border-bottom-color: var(--primary);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
